                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    pm.collectionVariables.set('bikeId1', pm.response.json().id);",
                  "} else if (pm.response.code === 409) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/api/v1/bicicletas/codigo/BIKE-001',",
                  "        method: 'GET',",
                  "        header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('tokenAdmin') }",
                  "    }, (err, res) => {",
                  "        if (err) return;",
                  "        const corpo = res.json();",
                  "        const lista = Array.isArray(corpo) ? corpo : [corpo];",
                  "        const found = lista.find(x => x.codigo === 'BIKE-001');",
                  "        if (found) pm.collectionVariables.set('bikeId1', found.id);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
