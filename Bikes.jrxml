	<query language="SQL"><![CDATA[SELECT
    l.id,
    c.nome                          AS cliente,
    b.codigo                        AS codigo_bicicleta,
    l.data_hora_retirada,
    l.data_hora_devolucao_efetiva,
    l.status,
    TIMESTAMPDIFF(MINUTE, l.data_hora_retirada,
                  COALESCE(l.data_hora_devolucao_efetiva, NOW())) AS duracao_minutos
FROM locacoes l
JOIN clientes   c ON c.id = l.cliente_id
JOIN bicicletas b ON b.id = l.bicicleta_id
ORDER BY l.data_hora_retirada DESC]]></query>
